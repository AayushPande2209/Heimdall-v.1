[Unit]
Description=Heimdall autonomous field recorder
After=local-fs.target

[Service]
Type=simple
User=aayushpande2009
Group=aayushpande2009
SupplementaryGroups=gpio i2c spi
WorkingDirectory=/home/aayushpande2009
RuntimeDirectory=heimdall-rig
RuntimeDirectoryMode=0750
ExecStart=/home/aayushpande2009/det/.venv/bin/python -m rig.recorder.controller
KillMode=process
TimeoutStopSec=120
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
