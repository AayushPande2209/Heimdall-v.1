[Unit]
Description=Pin Raspberry Pi CPU governor for reliable Lepton VoSPI capture
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'echo performance | /usr/bin/tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor >/dev/null'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
